# ── Server ────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent (default: info in production, debug in development)
LOG_LEVEL=
# Comma-separated list of allowed browser origins (website + admin)
CORS_ORIGINS=http://localhost:5173,http://localhost:4000
# Public base URL of this API (used for locally-stored image URLs)
PUBLIC_URL=http://localhost:3000
# Public URL of the website (used for links in e-mails; English users get an /en prefix)
APP_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wildlen

# ── Auth ──────────────────────────────────────────────
# At least 32 random characters. e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=
# Access token lifetime (seconds) and refresh token lifetime (days)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30
# Per-IP requests per 15 minutes on auth routes (login, register, refresh, …); 0 = off.
# Keep the default in production; 0 is handy for local end-to-end test runs.
AUTH_RATE_LIMIT=30
# true → creating photos / posts / polls / comments requires a verified e-mail
REQUIRE_EMAIL_VERIFICATION=false

# ── E-mail (Resend) ───────────────────────────────────
# Leave empty in development: e-mails (with their links) are printed to the log instead.
RESEND_API_KEY=
MAIL_FROM=WildLens <no-reply@wildlens.dev>

# ── Seed: initial admin account (npm run db:seed) ─────
ADMIN_EMAIL=admin@wildlens.dev
ADMIN_PASSWORD=change-me-please

# ── Cloudinary (optional) ─────────────────────────────
# Leave empty to store uploads on local disk under ./uploads (dev only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# ── Google sign-in ──
# OAuth client IDs from Google Cloud Console (APIs & Services → Credentials), comma-separated:
# the Web client used by the website, plus the iOS / Android clients for the mobile app.
GOOGLE_CLIENT_IDS=

# ── Machine translation of user content (optional) ──
# DeepL is preferred (free keys end with ":fx"); Google Cloud Translation is the fallback.
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
