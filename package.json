{
  "name": "wildlen-backend",
  "version": "2.0.0",
  "private": true,
  "description": "WildLens REST API — Express + Prisma + PostgreSQL",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:local": "tsx scripts/local-db.ts",
    "db:backfill": "tsx scripts/backfill-photo-areas.ts",
    "data:import-inat": "tsx scripts/import-inat.ts import"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "^11.7.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "6.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "^18.6.0-beta.19",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
